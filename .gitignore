# macOS
.DS_Store
**/.DS_Store

# Dependencies
node_modules/
frontend/node_modules/
server/node_modules/

# Build Artefakte
frontend/dist/
frontend/dist-ssr/
*.local

# Logs
*.log
npm-debug.log*

# Zertifikate und Schlüssel gehören nicht ins Repo — das Zertifikat des
# mAirListDB Servers kommt per API_DB_TLS_CERT (siehe COOLIFY.md)
server/certs/
*.key
*-key.pem
*_key.pem

# Environment
.env
.env.local
.env.*.local

# Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Playwright / Ad-hoc Skripte
smoke.mjs
smoke-playlist-tmp.mjs
playwright-report/
test-results/
# mAirList Datenbank
*.mldb
*.mldb-wal
*.mldb-shm
*.test.mldb

# Webinterface Auth-Datenbank (eigene User/Sessions/Tokens)
server/webinterface-auth.db*

# Panel-Einstellungen (generiert)
server/settings.json
